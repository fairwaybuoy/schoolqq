# cp 后生成强随机口令；scripts/bootstrap.py 可自动生成，不会覆盖现有 .env。
APP_TOKEN=CHANGE_ME_APP_TOKEN
ONEBOT_ACCESS_TOKEN=CHANGE_ME_ONEBOT_TOKEN
# 多群使用英文逗号；QQ ID 用字符串。登录账号必须已在这些群中。
GROUP_WHITELIST=demo-class
TIMEZONE=Asia/Shanghai
DATA_DIR=data
HOST=127.0.0.1
PORT=8080
# 可覆盖 NapCat WebUI 端口；未填写时读取 NapCat 配置，默认 6099。
# NAPCAT_HOME 可指定 NapCat 安装目录。
# NAPCAT_WEBUI_PORT=6099
# 留空可离线规则演示。可填写本地 OpenAI 兼容端点（/v1），无 key 也可用本地模型。
MODEL_BASE_URL=
MODEL=
MODEL_API_KEY=
# 每日调用次数限制（不是金额硬上限）；按服务商设置费用上限。
MODEL_DAILY_CALLS=30
MODEL_MIN_INTERVAL=2
MODEL_TIMEOUT=20
MODEL_MAX_TOKENS=2200
MAX_ATTEMPTS=3
RETENTION_DAYS=90
OCR_LANG=chi_sim+eng
TESSDATA_DIR=data/tessdata
